<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Simply.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Also use the Microsoft.Testing.Platform command line when the executable runs on its own, instead of xUnit's console runner. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\Simply.Core\Simply.Core.csproj" />
  </ItemGroup>

</Project>
